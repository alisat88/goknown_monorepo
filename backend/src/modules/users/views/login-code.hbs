{{> header}}
  <table cellpadding="0" cellspacing="0" border="0" width="88%" style="width: 88% !important; min-width: 88%; max-width: 88%;">
    <tr>
      <td align="left" valign="top">
          <font face="'Poppins', sans-serif" color="#1a1a1a" style="font-size: 38px; line-height: 60px; font-weight: 300; letter-spacing: -1.5px;">
            <span style="font-family: 'Poppins', Arial, Tahoma, Geneva, sans-serif; color: #1a1a1a; font-size: 32px; line-height: 60px; font-weight: 300; letter-spacing: -1.5px;">Hello {{name}},</span>
          </font>
          <div style="height: 33px; line-height: 33px; font-size: 31px;">&nbsp;</div>
          <font face="'Poppins', sans-serif" color="#585858" style="font-size: 18px; line-height: 32px;">
            <span style="font-family: 'Poppins', Arial, Tahoma, Geneva, sans-serif; color: #585858; font-size: 18px; line-height: 32px;">Use the login code below to finish signing in to DAppGenius. This code expires in 10 minutes.</span>
          </font>

          <div style="height: 33px; line-height: 33px; font-size: 31px;">&nbsp;</div>

          <font face="'Poppins', sans-serif" color="#585858" style="font-size: 18px; line-height: 32px;">
            <span style="font-family: 'Poppins', Arial, Tahoma, Geneva, sans-serif; color: #585858; font-size: 18px; line-height: 32px;">Your login code is: <b>{{code}}</b></span>
          </font>

          <div style="height: 75px; line-height: 75px; font-size: 73px;">&nbsp;</div>
      </td>
    </tr>
  </table>
{{> footer }}
