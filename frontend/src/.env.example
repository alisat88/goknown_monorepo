# Configurações da aplicação
REACT_APP_ENVIRONMENT=development
REACT_APP_PRODUCTION_API=https://node1.goknown.app/

# Bypass da verificação de SMS 2FA (true para ativar o bypass, false para desativar)
REACT_APP_BYPASS_SMS_2FA=false 

# Demo-only verification code for the simulated presenter-led login step
REACT_APP_ENABLE_DEMO_LOGIN=false
REACT_APP_DEMO_LOGIN_EMAIL=admin@goknown.com
REACT_APP_DEMO_LOGIN_PASSWORD=1234
REACT_APP_DEMO_2FA_CODE=123456
